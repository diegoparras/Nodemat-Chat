# ⚠️ Todas estas variables quedan EMBEBIDAS en el bundle JavaScript público.
# Úsalas sólo para instancias personales/locales, nunca en un deploy público.

# Login OPCIONAL: si VITE_ADMIN_PASSWORD está vacío no se pide contraseña.
# No es seguridad real: se valida en el navegador y queda en el bundle.
VITE_ADMIN_USER=
VITE_ADMIN_PASSWORD=

# API keys (opcionales: también se pueden cargar desde Ajustes)
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_OPENAI_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_CEREBRAS_API_KEY=
VITE_GEMINI_API_KEY=
VITE_XAI_API_KEY=

# Proveedores OpenAI-compatibles
VITE_CUSTOM1_NAME=
VITE_CUSTOM1_API_KEY=
VITE_CUSTOM1_API_URL=
VITE_CUSTOM1_MODEL=
VITE_CUSTOM2_NAME=
VITE_CUSTOM2_API_KEY=
VITE_CUSTOM2_API_URL=
VITE_CUSTOM2_MODEL=

# Registro de servidores MCP mostrado en Ajustes
VITE_MCP_REGISTRY_URL=

# ---------------------------------------------------------------------------
# Variables del SERVIDOR (funciones /api). TODAS OPCIONALES: Nodemat funciona
# sin ninguna, con toda la configuración guardada en el navegador del usuario.
# Sólo sirven para endurecer un despliegue público. Sin prefijo VITE_.
# ---------------------------------------------------------------------------

# Restringir el proxy MCP a ciertos hosts (coma separada, admite *.dominio)
# MCP_PROXY_ALLOWED_HOSTS=*.n8n.cloud

# Exigir un secreto compartido (el usuario lo carga en Ajustes → MCP → "Token del proxy")
# NODEMAT_PROXY_TOKEN=

# Sólo desarrollo local (npm run dev ya los activa): permitir http:// y servidores de tu red
# MCP_PROXY_ALLOW_HTTP=1
# MCP_PROXY_ALLOW_PRIVATE=1

# Apagar el puente stdio (servidores MCP de tipo comando) en tu instancia local
# MCP_STDIO_DISABLED=1

# Cuenta de ChatGPT: versión de Codex CLI que se declara al listar modelos.
# Si la lista de modelos sale vacía o desactualizada, ponla al día con la última de
# https://github.com/openai/codex/releases (sin el prefijo "rust-v").
# CHATGPT_CLIENT_VERSION=0.164.0
